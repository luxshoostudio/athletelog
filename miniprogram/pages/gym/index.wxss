.template-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.template-button {
  display: flex;
  min-height: 106rpx;
  margin: 0;
  padding: 18rpx 20rpx;
  align-items: center;
  justify-content: flex-start;
  gap: 14rpx;
  border: 2rpx solid #cbbfac;
  border-radius: 30rpx;
  background: #fffaf0;
  color: #292521;
  font-size: 26rpx;
  font-weight: 700;
}

.template-mark {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: #e4ead4;
  color: #566048;
  font-family: Georgia, serif;
  font-size: 24rpx;
}

.custom-row {
  display: flex;
  margin-top: 20rpx;
  gap: 12rpx;
}

.custom-input {
  box-sizing: border-box;
  min-width: 0;
  height: 88rpx;
  flex: 1;
  padding: 0 28rpx;
  border: 2rpx solid #cbbfac;
  border-radius: 999rpx;
  background: transparent;
  font-size: 27rpx;
}

.custom-add {
  display: flex;
  width: 124rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #d86424;
  color: #fffaf0;
  font-size: 26rpx;
  font-weight: 700;
}

.plan-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.plan-heading {
  margin-bottom: 4rpx;
}

.session-name {
  margin: 0 0 16rpx 4rpx;
  color: #3d3833;
  font-family: Georgia, serif;
  font-size: 30rpx;
  font-weight: 700;
}

.completion-pill {
  margin-bottom: 18rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #e3ead4;
  color: #4e5942;
  font-size: 21rpx;
  font-weight: 700;
}

.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.exercise-card {
  padding: 24rpx;
  transition: opacity 160ms ease;
}

.exercise-card.is-complete {
  opacity: 0.68;
}

.exercise-top {
  display: flex;
  align-items: center;
}

.check-button {
  display: flex;
  box-sizing: border-box;
  width: 62rpx;
  height: 62rpx;
  margin: 0 18rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 3rpx solid #9e947f;
  border-radius: 50%;
  background: transparent;
  color: #fffaf0;
  font-size: 30rpx;
  font-weight: 700;
}

.check-button.checked {
  border-color: #66724e;
  background: #66724e;
}

.exercise-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remove-button {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: transparent;
  color: #9d715e;
  font-size: 38rpx;
}

.exercise-fields {
  display: flex;
  margin-top: 22rpx;
  gap: 12rpx;
}

.metric-field {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.metric-field.wide {
  flex: 1.25;
}

.metric-field text {
  margin: 0 0 8rpx 6rpx;
  color: #7b7369;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.metric-field input {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: #eee7da;
  font-size: 27rpx;
  text-align: center;
}

.history-card {
  overflow: hidden;
  padding: 4rpx 26rpx;
}

.history-row {
  display: flex;
  min-height: 102rpx;
  align-items: center;
  border-bottom: 2rpx solid rgba(78, 68, 58, 0.1);
}

.history-row:last-child {
  border-bottom: 0;
}

.history-date {
  width: 100rpx;
  color: #bd5b25;
  font-family: Georgia, serif;
  font-size: 27rpx;
  font-weight: 700;
}

.history-copy {
  flex: 1;
}

.history-name {
  font-size: 26rpx;
  font-weight: 700;
}

.history-meta {
  margin-top: 5rpx;
  color: #7b7369;
  font-size: 21rpx;
}
