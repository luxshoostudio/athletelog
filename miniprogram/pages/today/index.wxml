<view class="screen">
  <view class="header-row">
    <view>
      <view class="display-title">{{dateLabel}}</view>
    </view>
    <view class="streak-pill">连续 {{streak}} 天</view>
  </view>

  <view class="period-row">
    <text>经期</text>
    <switch checked="{{period}}" color="#bd5b25" bindchange="togglePeriod" />
  </view>

  <view class="card hero-card">
    <view class="ring-wrap">
      <canvas canvas-id="proteinRing" class="protein-canvas" width="124" height="124"></canvas>
      <view class="ring-label">
        <text class="ring-number">{{proteinPct}}%</text>
        <text class="ring-caption">蛋白质</text>
      </view>
    </view>
    <view class="macro-column">
      <view class="macro-value">{{totals.protein}} <text>/ {{goals.protein}} g</text></view>
      <view class="macro-label">蛋白质</view>
      <view class="macro-divider"></view>
      <view class="macro-value">{{totals.calories}} <text>/ {{goals.calories}} 千卡</text></view>
      <view class="macro-label">卡路里 · {{caloriePct}}%</view>
    </view>
  </view>

  <view wx:if="{{favorites.length}}" class="section-heading">常用食物</view>
  <scroll-view wx:if="{{favorites.length}}" class="favorite-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="favorite-row">
      <button wx:for="{{favorites}}" wx:key="name" class="favorite-pill" data-index="{{index}}" bindtap="addFavorite">
        <text>{{item.name}}</text>
        <text class="favorite-macros">{{item.protein}}g · {{item.calories}}</text>
      </button>
    </view>
  </scroll-view>
  <view wx:else class="favorite-hint">记录几次食物后，常用项会自动出现在这里</view>

  <view class="add-actions">
    <button class="secondary-button camera-button" bindtap="recognizeFood">拍照识别</button>
    <button class="primary-button add-food" bindtap="openFoodSheet">+ 添加食物</button>
  </view>

  <view class="card water-card">
    <view>
      <view class="water-label">饮水</view>
      <view class="water-value">{{waterMl}} <text>/ {{waterGoal}} ml</text></view>
    </view>
    <view class="water-actions">
      <button class="water-add" data-amount="250" bindtap="addWater">+250</button>
      <button class="water-add" data-amount="500" bindtap="addWater">+500</button>
      <button class="water-reset" bindtap="resetWater">↺</button>
    </view>
  </view>

  <view class="section-heading">今日饮食</view>
  <view wx:if="{{foods.length}}" class="food-list">
    <view wx:for="{{foods}}" wx:key="id" class="card food-row">
      <view class="food-copy">
        <view class="food-name">{{item.name}}</view>
        <view class="food-macros">{{item.protein}}g 蛋白质 · {{item.calories}} 千卡</view>
      </view>
      <button class="delete-button" data-id="{{item.id}}" bindtap="deleteFood" aria-label="删除 {{item.name}}">×</button>
    </view>
  </view>
  <view wx:else class="card empty-state">还没有记录。点「添加食物」记第一笔吧。</view>

  <view class="coach-fab" bindtap="goToCoach">问教练</view>
</view>

<view wx:if="{{showFoodSheet}}" class="sheet-backdrop" bindtap="closeFoodSheet">
  <view class="food-sheet" catchtap="stopPropagation">
    <view class="sheet-handle"></view>
    <view class="sheet-title">添加食物</view>
    <label class="field-label">食物名称</label>
    <input class="field-input" value="{{foodName}}" placeholder="比如：三文鱼配米饭" bindinput="onFoodName" focus="{{showFoodSheet}}" />
    <view class="field-grid">
      <view class="field-half">
        <label class="field-label">蛋白质（克）</label>
        <input class="field-input" value="{{foodProtein}}" type="digit" placeholder="0" bindinput="onFoodProtein" />
      </view>
      <view class="field-half">
        <label class="field-label">卡路里</label>
        <input class="field-input" value="{{foodCalories}}" type="number" placeholder="0" bindinput="onFoodCalories" />
      </view>
    </view>
    <button class="primary-button sheet-save" bindtap="saveCustomFood">保存</button>
    <button class="sheet-cancel" bindtap="closeFoodSheet">取消</button>
  </view>
</view>
