<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional. Only install this once `alog-garmin` works when run by hand.

    cp tools/com.luxshoo.athletelog.garmin.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.luxshoo.athletelog.garmin.plist

  No credentials live here — alog-garmin reads them from the login Keychain,
  so this file is safe to commit and safe to read.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.luxshoo.athletelog.garmin</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/luxshoo/athletelog/tools/alog-garmin</string>
    <string>--days</string>
    <string>3</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/athletelog-garmin.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/athletelog-garmin.err</string>
</dict>
</plist>
